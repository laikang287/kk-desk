/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.laikang287.kklauncher",
  asar: true,
  compression: "maximum",
  productName: "KK Desk",
  copyright: "Copyright © 2026 KK Desk contributors",
  directories: {
    output: "release/${version}",
  },
  asarUnpack: ["**/*.node"],
  npmRebuild: false,
  files: ["dist", "dist-electron", "native", "!node_modules/**/*"],
  win: {
    appId: "com.laikang287.kklauncher",
    executableName: "KK-Desk",
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "${productName}-${version}-${arch}-Setup.${ext}",
    icon: "public/logo.ico",
  },
  nsis: {
    artifactName: "${productName}-${version}.${ext}",
    oneClick: false,
    allowElevation: true,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true,
    createStartMenuShortcut: true,
  },
  portable: {
    artifactName: "${productName}-${version}-${arch}-portable.${ext}",
  },
  afterAllArtifactBuild: "scripts/after-build.js",
  extraResources: [
    { from: "LICENSE", to: "LICENSE" },
    { from: "NOTICE.md", to: "NOTICE.md" },
    { from: "commons/data/locales/emoji/LICENSE.txt", to: "UNICODE-CLDR-LICENSE.txt" },
  ],
}
